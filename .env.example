# ==============================================================================
# VAYELLE Platform — Environment Configuration Template
# ==============================================================================
# COPY THIS FILE TO '.env' BEFORE RUNNING THE APPLICATION:
#   cp .env.example .env
#
# IMPORTANT SECURITY RULES:
# 1. NEVER commit your actual '.env' file or credentials to GitHub.
# 2. Never share database connection credentials publicly.
# 3. Keep production and Atlas passwords secure.
# ==============================================================================

# Flask Session Security Key
# Generate a secure random string for local development:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-secure-random-key-in-production

# ------------------------------------------------------------------------------
# Centralized MongoDB Database Configuration (Shared across all teammates)
# ------------------------------------------------------------------------------
# All teammates connect to the same shared MongoDB Atlas database so that shoe
# catalog records and manager uploads are immediately visible to everyone.
#
# Shared MongoDB Atlas URI Format:
# MONGO_URI=mongodb+srv://<db_username>:<db_password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
#
# For isolated offline local development only (uses local MongoDB daemon):
# MONGO_URI=mongodb://127.0.0.1:27017/vayelle_db
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Target Database Name (Must be vayelle_db for all teammates)
DB_NAME=vayelle_db

# ------------------------------------------------------------------------------
# Cloudinary API Configuration (Athoy Roy — Module 1)
# ------------------------------------------------------------------------------
# Cloudinary provides centralized cloud image hosting and CDN delivery.
# Shoe images are stored on Cloudinary; MongoDB stores only the secure HTTPS URLs.
#
# Note for Teammates:
# - Teammates who only browse shoes (/explore) do NOT need Cloudinary upload keys;
#   shoe cards deliver images directly through public Cloudinary CDN URLs.
# - Authorized Managers who upload new shoe images through /manager/dashboard
#   require valid Cloudinary credentials below to authorize upload API calls.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# Flask Runtime Settings
# ------------------------------------------------------------------------------
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
