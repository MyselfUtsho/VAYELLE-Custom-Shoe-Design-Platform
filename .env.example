# VAYELLE Environment Configuration

# Flask Secret Key for Session Security
SECRET_KEY=change-this-to-a-secure-random-key-in-production

# MongoDB Connection URI (Local or MongoDB Atlas)
# Example Local: mongodb://localhost:27017/vayelle_db
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/vayelle_db?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/vayelle_db

# Database Name
DB_NAME=vayelle_db

# Cloudinary API Configuration (Athoy Roy — Module 1)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Flask Environment
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
